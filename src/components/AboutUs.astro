---
<section id="about" class="py-24 px-6 bg-canvas-elevated border-t border-hairline">
  <div class="max-w-6xl mx-auto flex flex-col lg:flex-row items-center gap-16">
    <div class="flex-1">
      <h2 class="text-xs font-mono uppercase tracking-widest text-mute mb-4">About Us</h2>
      <h3 class="text-3xl md:text-4xl font-semibold tracking-tight text-ink mb-6">
        Building careers since 2010.
      </h3>
      <p class="text-lg text-body mb-6 leading-relaxed">
        Britech Coaching Centre was established with a mission to bridge the digital divide. We provide high-quality computer education with a focus on practical, industry-relevant skills.
      </p>
      <div class="space-y-4 mb-8">
        <div class="flex gap-4">
          <div class="w-10 h-10 rounded-sm bg-canvas border border-hairline flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <div>
            <h4 class="font-semibold text-ink">Our Mission</h4>
            <p class="text-sm text-body">To empower students with accessible, high-quality technology education.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="w-10 h-10 rounded-sm bg-canvas border border-hairline flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
          </div>
          <div>
            <h4 class="font-semibold text-ink">Our Vision</h4>
            <p class="text-sm text-body">To be the leading tech-education provider creating job-ready professionals.</p>
          </div>
        </div>
      </div>
    </div>
    
    <div class="flex-1 w-full relative">
      <div class="absolute inset-0 bg-gradient-to-tr from-gradient-start/5 to-gradient-end/5 blur-3xl -z-10 rounded-full"></div>
      {/* Placeholder for About Image */}
      <div class="aspect-square md:aspect-[4/3] bg-canvas border border-hairline rounded-lg shadow-xl overflow-hidden flex flex-col items-center justify-center text-mute relative group">
        <svg class="w-10 h-10 mb-2 opacity-50 transition-transform group-hover:scale-110" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m3-4h1m-1 4h1m-5 8h8"/></svg>
        <span class="font-mono text-sm">centre-exterior.jpg</span>
      </div>
    </div>
  </div>
</section>
