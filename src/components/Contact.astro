---
---
<section id="contact" class="py-24 px-6 bg-canvas-elevated border-t border-hairline">
  <div class="max-w-6xl mx-auto">
    <div class="mb-16 text-center">
      <h2 class="text-xs font-mono uppercase tracking-widest text-mute mb-4">Contact & Admissions</h2>
      <h3 class="text-3xl md:text-4xl font-semibold tracking-tight text-ink">
        Get in touch with us.
      </h3>
    </div>

    <div class="flex flex-col lg:flex-row gap-12">
      {/* Contact Info */}
      <div class="flex-1 space-y-8">
        <div>
          <h4 class="text-lg font-semibold text-ink mb-4">BRITECH IT</h4>
          <p class="text-body text-sm leading-relaxed mb-6">
            123 Education Street, Tech Park<br />
            New Delhi, India 110001
          </p>
          <div class="space-y-3 text-sm">
            <a href="tel:+919933242072" class="flex items-center text-ink hover:text-primary transition-colors">
              <svg class="w-5 h-5 mr-3 text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              +91 99332 42072
            </a>
            <a href="mailto:info@britech.edu" class="flex items-center text-ink hover:text-primary transition-colors">
              <svg class="w-5 h-5 mr-3 text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              info@britech.edu
            </a>
            <div class="flex items-center text-ink">
              <svg class="w-5 h-5 mr-3 text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              Mon-Sat: 9:00 AM - 7:00 PM
            </div>
          </div>
        </div>

        <div class="aspect-video w-full bg-canvas border border-hairline rounded-sm flex items-center justify-center text-mute overflow-hidden relative">
          <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d488.43111822410714!2d92.73264513436608!3d11.66256190634011!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x308895b8c576658f%3A0x18c4c1c6ab1ca4b0!2sBRITECH%20IT%20Group%20Of%20Institution!5e0!3m2!1sen!2sin!4v1790765777607!5m2!1sen!2sin" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
        </div>
      </div>

      {/* Enquiry Form */}
      <div class="flex-1">
        <form id="enquiryForm" class="bg-canvas border border-hairline rounded-md p-8 shadow-sm">
          <h4 class="text-xl font-semibold text-ink mb-6">Admission Enquiry</h4>
          
          <div class="space-y-4">
            <div>
              <label class="block text-sm font-medium text-ink mb-1">Full Name</label>
              <input required type="text" id="waName" class="w-full px-4 py-2 bg-canvas-elevated border border-hairline rounded-sm text-sm text-ink focus:outline-none focus:border-mute" placeholder="John Doe" />
            </div>
            
            <div>
              <label class="block text-sm font-medium text-ink mb-1">Course Interested In</label>
              <select required id="waCourse" class="w-full px-4 py-2 bg-canvas-elevated border border-hairline rounded-sm text-sm text-ink focus:outline-none focus:border-mute">
                <option value="" disabled selected>Select a course...</option>
                <option value="PGADCA">PGADCA</option>
                <option value="ADCA">ADCA</option>
                <option value="Tally">Tally Prime with GST</option>
                <option value="Other">Other</option>
              </select>
            </div>
            
            <div>
              <label class="block text-sm font-medium text-ink mb-1">Preferred Batch</label>
              <select required id="waBatch" class="w-full px-4 py-2 bg-canvas-elevated border border-hairline rounded-sm text-sm text-ink focus:outline-none focus:border-mute">
                <option value="" disabled selected>Select timing...</option>
                <option value="Morning">Morning (9 AM - 12 PM)</option>
                <option value="Afternoon">Afternoon (1 PM - 4 PM)</option>
                <option value="Evening">Evening (5 PM - 7 PM)</option>
              </select>
            </div>
            
            <div>
              <label class="block text-sm font-medium text-ink mb-1">Message (Optional)</label>
              <textarea id="waMessage" rows="3" class="w-full px-4 py-2 bg-canvas-elevated border border-hairline rounded-sm text-sm text-ink focus:outline-none focus:border-mute" placeholder="Any specific questions?"></textarea>
            </div>
          </div>
          
          <div class="mt-8 flex gap-4">
            <button type="submit" class="flex-1 px-4 py-2 text-sm font-medium text-on-primary bg-primary rounded-sm hover:opacity-90 transition-opacity">
              Apply Now via WhatsApp
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  document.getElementById('enquiryForm').addEventListener('submit', (e) => {
    e.preventDefault();
    const name = document.getElementById('waName').value;
    const course = document.getElementById('waCourse').value;
    const batch = document.getElementById('waBatch').value;
    const msg = document.getElementById('waMessage').value;
    
    const text = `Hi BRITECH IT! I'm interested in admission.
*Name:* ${name}
*Course:* ${course}
*Batch:* ${batch}
*Message:* ${msg || 'N/A'}`;

    const encoded = encodeURIComponent(text);
    const waUrl = `https://wa.me/919933242072?text=${encoded}`;
    window.open(waUrl, '_blank');
  });
</script>
