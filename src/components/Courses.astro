---
import { courses } from '../data/courses.js';
const { showViewAll = true } = Astro.props;
---
<section id="courses" class="py-24 px-6 bg-canvas relative">
  <div class="max-w-6xl mx-auto">
    <div class="mb-16 text-center md:text-left">
      <h2 class="text-xs font-mono uppercase tracking-widest text-mute mb-4">Our Programs</h2>
      <h3 class="text-3xl md:text-4xl font-semibold tracking-tight text-ink mb-6">
        Industry-focused computer courses.
      </h3>
      <div class="flex justify-center md:justify-start gap-2">
        <input type="text" id="course-search" placeholder="Search courses..." class="w-full md:w-80 px-4 py-2 bg-canvas-elevated border border-hairline rounded-sm text-sm text-ink focus:outline-none focus:border-mute transition-colors" />
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="courses-grid">
      {courses.map(course => (
        <div class="course-card group bg-canvas-elevated border border-hairline rounded-md p-6 hover:border-mute transition duration-300 hover:shadow-[0_8px_30px_rgb(0,0,0,0.04)] flex flex-col h-full">
          {/* Course Image */}
          <div class="w-full aspect-video bg-canvas border border-hairline rounded-sm mb-6 relative flex items-center justify-center overflow-hidden">
             <span class="text-xs font-mono text-mute">[{course.id}-icon.jpg]</span>
             <img src={`/${course.id}-icon.jpg`} alt={`${course.title} Icon`} class="absolute inset-0 w-full h-full object-cover" onerror="this.style.display='none';" />
          </div>
          
          <h4 class="text-xl font-semibold text-ink mb-2">{course.title}</h4>
          <p class="text-sm text-body leading-relaxed mb-6 flex-grow">{course.desc}</p>
          
          <div class="space-y-2 mb-6 text-sm text-ink">
            <div class="flex justify-between border-b border-hairline pb-2">
              <span class="text-mute">Duration</span>
              <span class="font-medium">{course.duration}</span>
            </div>
            <div class="flex justify-between border-b border-hairline pb-2">
              <span class="text-mute">Mode</span>
              <span class="font-medium">{course.mode}</span>
            </div>
            <div class="flex justify-between border-b border-hairline pb-2">
              <span class="text-mute">Eligibility</span>
              <span class="font-medium">{course.eligibility}</span>
            </div>
            <div class="flex justify-between pt-1">
              <span class="text-mute">Fee</span>
              <span class="font-medium text-primary">{course.fee}</span>
            </div>
          </div>

          <div class="flex flex-col gap-2 mt-auto">
            <a href={`/britechit/courses/${course.id}`} class="w-full px-4 py-2 text-sm font-medium text-center text-ink bg-canvas-elevated border border-hairline rounded-sm hover:bg-canvas transition-colors">
              View Details
            </a>
            <a href={`/britechit/#contact?course=${course.id}`} class="w-full px-4 py-2 text-sm font-medium text-center text-on-primary bg-primary rounded-sm hover:opacity-90 transition-opacity">
              Enroll Now
            </a>
          </div>
        </div>
      ))}
    </div>
    
    {showViewAll && (
      <div class="mt-12 text-center">
        <a href="/britechit/courses" class="inline-block px-8 py-3 bg-primary text-on-primary font-medium rounded-sm hover:opacity-90 transition-opacity">
          View All Courses
        </a>
      </div>
    )}
  </div>
</section>

<script>
  const searchInput = document.getElementById('course-search');
  const courseCards = Array.from(document.querySelectorAll('.course-card'));

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      // @ts-ignore
      const searchTerm = e.target.value.toLowerCase().trim();

      if (!searchTerm) {
        courseCards.forEach((card) => {
          // @ts-ignore
          card.style.order = '0';
          // @ts-ignore
          card.style.display = 'flex';
        });
        return;
      }

      courseCards.forEach((card) => {
        // @ts-ignore
        const title = card.querySelector('h4').innerText.toLowerCase();
        // @ts-ignore
        const text = card.innerText.toLowerCase();
        
        let score = 0;
        if (title.startsWith(searchTerm)) {
          score = 3;
        } else if (title.includes(searchTerm)) {
          score = 2;
        } else if (text.includes(searchTerm)) {
          score = 1;
        }

        if (score > 0) {
          // @ts-ignore
          card.style.display = 'flex';
          // Lower order value comes first in CSS grid
          // @ts-ignore
          card.style.order = -score; 
        } else {
          // @ts-ignore
          card.style.display = 'none';
        }
      });
    });
  }
</script>
