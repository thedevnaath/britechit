---
const faqs = [
  { q: "What courses do you offer?", a: "We offer PGADCA, ADCA, Tally Prime with GST, and various other specialized computer application courses." },
  { q: "What are the course fees?", a: "Course fees vary by program. ADCA is ₹12,000, PGADCA is ₹15,000, and Tally is ₹5,000. Installment options are available." },
  { q: "Are classes online or offline?", a: "We primarily offer offline practical training, but select advanced modules are available online." },
  { q: "Do you provide certificates?", a: "Yes, we provide a recognized certificate upon successful completion of the course and final assessment." },
  { q: "Is there a demo class?", a: "Yes, you can book a free 2-day demo class before committing to any of our long-term courses." }
];
---
<section id="faq" class="py-24 px-6 bg-canvas border-t border-hairline">
  <div class="max-w-4xl mx-auto">
    <div class="mb-12 text-center">
      <h2 class="text-xs font-mono uppercase tracking-widest text-mute mb-4">FAQ</h2>
      <h3 class="text-3xl font-semibold tracking-tight text-ink">Frequently Asked Questions</h3>
    </div>

    <div class="space-y-4">
      {faqs.map((faq, i) => (
        <details class="group bg-canvas-elevated border border-hairline rounded-sm p-6 open:shadow-sm transition-all duration-300">
          <summary class="flex justify-between items-center font-medium cursor-pointer list-none text-ink text-lg">
            {faq.q}
            <span class="transition group-open:rotate-180">
              <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
            </span>
          </summary>
          <p class="text-body mt-4 text-sm leading-relaxed">
            {faq.a}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>
