---
import logoImage from '../assets/logo.jpg';
---
<footer class="py-12 px-6 bg-canvas border-t border-hairline">
  <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-12">
    <div>
      <div class="flex items-center gap-2 mb-4">
        <img src={logoImage.src} alt="BRITECH IT Logo" class="w-6 h-6 rounded-full object-cover" />
        <span class="font-medium text-ink">BRITECH IT</span>
      </div>
      <p class="text-sm text-body leading-relaxed mb-6">
        Premium computer education shaping the future of technology professionals.
      </p>
      <div class="flex gap-4">
        <a href="#" class="w-8 h-8 rounded-full bg-canvas-elevated border border-hairline flex items-center justify-center text-ink hover:bg-canvas transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        </a>
        <a href="#" class="w-8 h-8 rounded-full bg-canvas-elevated border border-hairline flex items-center justify-center text-ink hover:bg-canvas transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
        </a>
        <a href="#" class="w-8 h-8 rounded-full bg-canvas-elevated border border-hairline flex items-center justify-center text-ink hover:bg-canvas transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </a>
      </div>
    </div>
    
    <div>
      <h4 class="font-semibold text-ink mb-4 text-sm">Quick Links</h4>
      <ul class="space-y-2 text-sm text-body">
        <li><a href="/" class="hover:text-link transition-colors">Home</a></li>
        <li><a href="#about" class="hover:text-link transition-colors">About Us</a></li>
        <li><a href="#gallery" class="hover:text-link transition-colors">Gallery</a></li>
        <li><a href="#contact" class="hover:text-link transition-colors">Contact</a></li>
      </ul>
    </div>

    <div>
      <h4 class="font-semibold text-ink mb-4 text-sm">Courses</h4>
      <ul class="space-y-2 text-sm text-body">
        <li><a href="#courses" class="hover:text-link transition-colors">PGADCA</a></li>
        <li><a href="#courses" class="hover:text-link transition-colors">ADCA</a></li>
        <li><a href="#courses" class="hover:text-link transition-colors">Tally Prime</a></li>
      </ul>
    </div>

    <div>
      <h4 class="font-semibold text-ink mb-4 text-sm">Policies</h4>
      <ul class="space-y-2 text-sm text-body">
        <li><a href="#" class="hover:text-link transition-colors">Privacy Policy</a></li>
        <li><a href="#" class="hover:text-link transition-colors">Terms & Conditions</a></li>
        <li><a href="#" class="hover:text-link transition-colors">Refund Policy</a></li>
      </ul>
    </div>
  </div>
  
  <div class="max-w-6xl mx-auto pt-8 border-t border-hairline flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-mute">
    <div>&copy; {new Date().getFullYear()} BRITECH IT. All rights reserved.</div>
    <div class="flex items-center gap-1">
      <a href="#top" class="hover:text-ink transition-colors flex items-center gap-1">
        Back to Top
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/></svg>
      </a>
    </div>
  </div>
</footer>
