---
const images = [
  "classroom-1.jpg", "lab-computers.jpg", "event-2025.jpg",
  "certificate-dist.jpg", "workshop.jpg", "student-activities.jpg"
];
---
<section id="gallery" class="py-24 px-6 bg-canvas border-t border-hairline">
  <div class="max-w-6xl mx-auto">
    <div class="mb-12 flex justify-between items-end">
      <div>
        <h2 class="text-xs font-mono uppercase tracking-widest text-mute mb-4">Gallery</h2>
        <h3 class="text-3xl font-semibold tracking-tight text-ink">Life at BRITECH IT.</h3>
      </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
      {images.map(img => (
        <div class="aspect-square bg-canvas-elevated border border-hairline rounded-sm overflow-hidden flex items-center justify-center relative group hover:border-mute transition-colors">
          <span class="text-xs font-mono text-mute z-10 bg-canvas/80 px-2 py-1 rounded backdrop-blur-sm">[{img}]</span>
          <img src={`/britechit/${img}`} alt="Gallery Image" class="absolute inset-0 w-full h-full object-cover z-20" onerror="this.style.display='none';" />
          <div class="absolute inset-0 group-hover:bg-ink/5 transition-colors z-30 pointer-events-none"></div>
        </div>
      ))}
    </div>
  </div>
</section>
