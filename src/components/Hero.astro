<section class="relative pt-24 pb-24 px-6 md:pt-40 md:pb-32 overflow-hidden flex flex-col items-center text-center">
  {/* Mesh Gradient Background (Pure CSS) */}
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] opacity-20 pointer-events-none blur-[100px] -z-10"
       style="background: radial-gradient(circle at 50% 50%, var(--color-gradient-start), var(--color-gradient-mid), var(--color-gradient-end), transparent 70%);">
  </div>

  <div class="inline-flex items-center gap-2 px-3 py-1 mb-8 rounded-full border border-hairline bg-canvas-elevated text-xs font-medium text-body shadow-sm">
    <span class="flex h-2 w-2 rounded-full bg-link"></span>
    Admissions Open for 2026 Batch
  </div>

  <h1 class="text-4xl md:text-6xl lg:text-7xl font-semibold tracking-[-0.05em] leading-[1.1] max-w-4xl mb-6 text-ink">
    Master the digital world. <br class="hidden md:block" />
    <span class="text-transparent bg-clip-text bg-gradient-to-r from-gradient-start via-gradient-mid to-gradient-end">
      Shape your future.
    </span>
  </h1>

  <p class="text-lg md:text-xl text-body max-w-2xl mb-10 font-normal leading-relaxed">
    Empowering students with premium computer education. We combine expert instructors, practical training, and modern infrastructure to build your career.
  </p>

  <div class="flex flex-col sm:flex-row items-center gap-4 mb-16">
    <a href="#courses" class="w-full sm:w-auto px-6 py-3 text-base font-medium text-on-primary bg-primary hover:opacity-90 rounded-pill transition-all shadow-md">
      Explore Courses
    </a>
    <a href="#contact" class="w-full sm:w-auto px-6 py-3 text-base font-medium text-ink bg-canvas-elevated border border-hairline rounded-pill hover:bg-canvas transition-all">
      Enquire Now
    </a>
    <a href="https://wa.me/919876543210" target="_blank" class="w-full sm:w-auto px-6 py-3 text-base font-medium text-[#25D366] bg-[#25D366]/10 border border-[#25D366]/20 rounded-pill hover:bg-[#25D366]/20 transition-all flex items-center justify-center gap-2">
      WhatsApp Us
    </a>
  </div>

  {/* Hero Image / Classroom Image Placeholder */}
  <div class="w-full max-w-5xl aspect-video bg-canvas-elevated border border-hairline rounded-lg shadow-2xl overflow-hidden relative flex items-center justify-center text-mute">
    {/* USER: Upload hero-image.jpg to public/ folder and replace this div with: <img src="/hero-image.jpg" alt="Classroom" class="w-full h-full object-cover" /> */}
    <div class="text-center">
      <svg class="w-12 h-12 mx-auto mb-2 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
      <p class="font-mono text-sm">[ classroom-hero.jpg placeholder ]</p>
    </div>
  </div>
</section>
